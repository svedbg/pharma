<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  macOS equivalent of systemd/pharma-desk.{service,timer}. Placeholders
  __PHARMA_DIR__, __HOME__ and __PATH_EXTRA__ are substituted by
  launchd/install-launchd.sh into ~/Library/LaunchAgents/.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.pharma.desk</string>

  <!--
    Start/exit markers bracket every run. Without them an unattended failure
    (claude not on PATH, network down, a python that cannot parse XML) leaves an
    empty log indistinguishable from "nothing to report" -- which is this
    system's normal output and therefore the easiest failure to miss.

    __PATH_EXTRA__ is baked in at install time. `zsh -lc` is a login but
    NON-interactive shell: it sources .zprofile but not .zshrc, so anything a
    version manager puts on PATH interactively is invisible here.

    The tomllib/pyexpat probe is the runtime half of the install-time check.
    tomllib means python is 3.11+; pyexpat means Form 4 insider XML actually
    parses. A python missing the second still runs the whole desk and merely
    records `degraded`, so nothing would ever draw attention to it.
  -->
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>-lc</string>
    <string>export PATH="__PATH_EXTRA__:$PATH"; cd '__PHARMA_DIR__' &amp;&amp; echo "=== $(date '+%Y-%m-%d %H:%M:%S') pharma-desk start ===" &amp;&amp; { command -v claude &gt;/dev/null || { echo "FATAL: claude not on PATH (re-run launchd/install-launchd.sh)"; exit 127; }; } &amp;&amp; { python3 -c 'import tomllib, pyexpat' || { echo "FATAL: python3 lacks tomllib or pyexpat (need 3.11+ with a working expat); re-run launchd/install-launchd.sh"; exit 78; }; } &amp;&amp; { sleep $((RANDOM % 240)); ./run_daily.sh; rc=$?; echo "=== exit $rc ==="; exit $rc; }</string>
  </array>

  <!--
    23:18 Europe/Sofia, Mon-Fri. The US close (16:00 ET) lands at 22:00-23:00
    Sofia time in every daylight-saving alignment, so the daily bar is always
    settled. Off-the-hour on purpose; the `sleep $((RANDOM % 240))` above is the
    equivalent of the systemd unit's RandomizedDelaySec=240.

    launchd has no Persistent= key: a calendar job missed while the machine was
    asleep or off runs once at the next wake, which is the behaviour wanted here.
  -->
  <key>StartCalendarInterval</key>
  <array>
    <dict><key>Weekday</key><integer>1</integer><key>Hour</key><integer>23</integer><key>Minute</key><integer>18</integer></dict>
    <dict><key>Weekday</key><integer>2</integer><key>Hour</key><integer>23</integer><key>Minute</key><integer>18</integer></dict>
    <dict><key>Weekday</key><integer>3</integer><key>Hour</key><integer>23</integer><key>Minute</key><integer>18</integer></dict>
    <dict><key>Weekday</key><integer>4</integer><key>Hour</key><integer>23</integer><key>Minute</key><integer>18</integer></dict>
    <dict><key>Weekday</key><integer>5</integer><key>Hour</key><integer>23</integer><key>Minute</key><integer>18</integer></dict>
  </array>

  <key>StandardOutPath</key>
  <string>__HOME__/Library/Logs/pharma-desk.log</string>
  <key>StandardErrorPath</key>
  <string>__HOME__/Library/Logs/pharma-desk.err.log</string>

  <key>RunAtLoad</key>
  <false/>
</dict>
</plist>
