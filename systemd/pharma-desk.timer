[Unit]
Description=Morning run of the biotech desk, analysing the session that closed the previous evening

[Timer]
# 09:00 Europe/Sofia, the day AFTER the session it analyses -- hence Tue-Sat.
#
# The time is measured, not reasoned about, because reasoning about it has now
# been wrong twice. The `runs` table records (run_at, session_date) for every
# fetch that ever persisted, which is a direct log of when the provider had
# published a given session's bar:
#
#   ABSENT   16:25 ET, 16:27 ET, 18:36 ET, 18:37 ET, 18:40 ET  (5 runs)
#   PRESENT  01:52 ET, 01:59 ET, 02:33 ET, 03:07 ET, 03:11 ET, 03:55 ET
#
# Nasdaq's historical endpoint does not have the day's row in the evening at
# all; it has it by the small hours of the following morning, ET. The earliest
# confirmed sighting is 01:52 ET = 08:52 Sofia, so 09:00 Sofia is the first
# clock time this desk has evidence for.
#
# This was 23:18 Mon-Fri (18 minutes after the close) and then 01:30 Tue-Sat,
# and BOTH lost on every single scheduled run -- 3 for 3 each:
#
#   2026-08-17 23:27  session is 2026-08-14, not today
#   2026-08-18 23:25  session is 2026-08-17, not today
#   2026-08-19 23:26  session is 2026-08-18, not today
#   2026-08-22 01:33  session is 2026-08-20, not 08-21
#   2026-08-25 01:32  session is 2026-08-21, not 08-24
#   2026-08-26 01:34  session is 2026-08-24, not 08-25
#
# 01:30 Sofia is 18:30 ET, which sits inside the ABSENT band above -- the move
# from 23:18 bought 2 hours 12 minutes and needed roughly seven. Every report
# was named for the session before the one that had just closed, and from
# 2026-08-22 that also broke the pre-market pass outright: premarket_delta.py
# correctly refuses when the baseline and the morning name different sessions,
# so it failed every weekday and the only thing the desk sent was its own
# failure notice.
#
# The 14:30 pre-market pass is the ceiling on how late this can go. 09:00
# leaves 5.5 hours, against a run bounded at 107 minutes worst case and
# typically under 20.
#
# Tue-Sat because the run still crosses midnight relative to its session:
# Monday's session is analysed at 09:00 Tuesday, Friday's at 09:00 Saturday.
# Nothing downstream cares -- the report is named for the session out of
# signals.json, not for the run date -- but the day-of-week spec has to move
# with the hour or Monday's session would never be analysed and Friday's would
# be analysed twice.
OnCalendar=Tue-Sat 09:00
RandomizedDelaySec=240
# Catch up if the laptop was asleep or powered off at the scheduled time. Safe
# at this hour for the same reason the hour was chosen: the bar it missed was
# already published when the run was due, so a late run analyses the same
# session it would have.
Persistent=true
Unit=pharma-desk.service

[Install]
WantedBy=timers.target
