# Generated and personal output. None of this belongs in git:
#   data/   fetched snapshots AND history.sqlite, which holds your paper-trade
#           log and the full alert history -- these are personal records
#   state/  alert dedupe state
#   logs/   run logs
data/
logs/
state/

# Your actual watchlist is a trading plan -- names, entry zones, invalidation
# levels. watchlist.example.toml is committed in its place so the repo runs.
watchlist.toml

# Screen output -- regenerate with `make screen`
candidates.toml
data/screen_candidates.toml

# Your objective, risk posture and broker preferences -- personal, not code.
STRATEGY.local.md

# Generated PDF -- rebuild with: make briefing
docs/*.pdf

# Dev virtualenv (runtime needs none)
.venv/

# Reports are personal research notes; drop this line if you want them versioned.
reports/

# Never commit credentials. The real file lives at ~/.config/pharma/notify.env,
# outside this repo -- these rules catch stray copies made inside it.
pharma.env
notify.env
*.env
.env
.env.*
!*.env.example
!.env.example
__pycache__/
*.pyc
