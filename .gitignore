# Generated and personal output. None of this belongs in git:
#   data/   fetched snapshots AND history.sqlite, which holds your paper-trade
#           log and the full alert history -- these are personal records
#   state/  alert dedupe state
#   logs/   run logs
data/
logs/
state/

# Your actual watchlist is a trading plan -- names, entry zones, invalidation
# levels. watchlist.example.toml is committed in its place so the repo runs.
watchlist.toml

# Your catalyst calendar names the same companies, and adds what you think each
# binary is worth. The daily run appends to it unattended, so leaving it tracked
# publishes every name the desk establishes a date for, on its own schedule.
# catalysts.example.toml is committed in its place, and CI checks that instead.
catalysts.toml

# Screen output -- regenerate with `make screen`
candidates.toml
data/screen_candidates.toml

# Your objective, risk posture and broker preferences -- personal, not code.
STRATEGY.local.md

# Personal Claude Code settings for this repo (model choice, auto-mode context).
.claude/settings.local.json

# macOS Finder metadata.
.DS_Store

# Generated PDFs. The capability brief is committed so it has a stable, linkable
# URL for sharing; the internal briefing stays generated-only.
docs/*.pdf
!docs/the-91-percent-question.pdf

# Dev virtualenv (runtime needs none). `make setup` does an editable install,
# which drops an egg-info tree next to it.
.venv/
*.egg-info/

# Local browsable archive built from reports/ -- same personal content,
# same reason to keep it out of git.
site/

# Reports are personal research notes; drop this line if you want them versioned.
reports/

# Never commit credentials. The real file lives at ~/.config/pharma/notify.env,
# outside this repo -- these rules catch stray copies made inside it.
pharma.env
notify.env
*.env
.env
.env.*
!*.env.example
!.env.example
__pycache__/
*.pyc
